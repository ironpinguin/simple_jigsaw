# Fail an install when a dependency's install script has not been reviewed
# (#141). The decisions live in package.json under `allowScripts`, maintained
# with `npm install-scripts approve|deny`; see CONTRIBUTING.md. Without this,
# npm only lists unreviewed scripts — and once it blocks them by default it
# would skip them silently, leaving no SQLite driver and no Prisma engine to
# fail only at boot. Applies everywhere npm reads this file: local installs,
# the dev container (bind mount), CI and the Docker build.
strict-allow-scripts=true
# `npm install-scripts approve` writes name-only entries, not `pkg@1.2.3`: a
# pinned approval stops covering the package at its next Dependabot bump and
# fails CI (#141, see CONTRIBUTING.md). Set here so nobody has to remember a flag.
allow-scripts-pin=false
