{
  "name": "jigsawprivate",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:push": "node scripts/prisma.mjs db push --skip-generate",
    "make-admin": "node scripts/make-admin.mjs",
    "create-user": "node scripts/create-user.mjs",
    "purge-expired": "node scripts/purge-expired.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "konva": "^9.3.16",
    "next": "^15.5.25",
    "next-auth": "^5.0.0-beta.25",
    "next-intl": "^4.13.5",
    "nodemailer": "^9.0.5",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.0.2",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@formatjs/intl-localematcher": "^0.8.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.4",
    "jsdom": "^29.1.1",
    "negotiator": "^1.0.0",
    "prisma": "^6.2.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "//overrides": "Transitive security fixes the parent package cannot pull in itself: next pins postcss to an exact 8.4.31 and its optional sharp to ^0.34.3, @eslint/eslintrc still resolves the 1.x line of brace-expansion via minimatch@3, and @auth/core's nodemailer peer range (^7.0.7 || ^8.0.5) predates the 9.0.1 fix — safe to force here because we only register the Credentials provider, so @auth/core never loads nodemailer (our own SMTP code in lib/mail.ts does). Drop an entry once the parent ships a patched range.",
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "$sharp",
    "nodemailer": "$nodemailer",
    "brace-expansion@^1": "^1.1.18"
  }
}
