# --- Database ---
# Dev default: local SQLite file. For production switch the Prisma provider to
# "postgresql" in prisma/schema.prisma and set a Postgres URL here, e.g.:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/jigsaw?schema=public"
DATABASE_URL="file:./dev.db"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me-please-generate-a-real-secret"

# --- Image storage ---
# STORAGE_DRIVER: "fs" (local filesystem, dev default) or "s3" (MinIO / S3).
STORAGE_DRIVER="fs"

# Local filesystem driver: directory where uploaded images are written.
STORAGE_FS_DIR="./storage-data"

# S3 / MinIO driver (used when STORAGE_DRIVER="s3"):
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="jigsaw"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# Set true for MinIO / path-style addressing.
S3_FORCE_PATH_STYLE="true"
