# These values are for running tooling on the HOST (e.g. `npx prisma studio`)
# against the docker-compose services. When the app runs inside compose, the
# same variables are injected by docker-compose.yml with in-network hostnames
# (postgres / minio) instead of localhost.

# --- Database ---
# Provider: "postgresql" (default) or "sqlite".
DATABASE_PROVIDER="postgresql"
# Postgres (default):
DATABASE_URL="postgresql://jigsaw:jigsaw@localhost:5432/jigsaw?schema=public"
# SQLite alternative (no server needed):
#   DATABASE_PROVIDER="sqlite"
#   DATABASE_URL="file:./prisma/dev.db"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me-please-generate-a-real-secret"

# --- Reverse proxy ---
# How many trailing x-forwarded-for entries are appended by YOUR OWN reverse
# proxies: 1 = one proxy (nginx/traefik/caddy), 2 = a load balancer in front
# of it, and so on. Leave at 0 when Next.js is exposed directly — the default
# docker-compose setup. The header is client-forgeable, so with 0 the report
# rate limit ignores it and uses one shared bucket instead of trusting it, and
# duplicate reports of the same puzzle are no longer filtered (a bucket shared
# by everyone cannot tell two reporters apart). Set this correctly if you run
# behind nginx/traefik — a wrong value is rejected, not silently ignored.
TRUSTED_PROXY_HOPS="0"

# --- Image storage (S3 / RustFS) ---
STORAGE_DRIVER="s3"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="jigsaw"
S3_ACCESS_KEY_ID="rustfsadmin"
S3_SECRET_ACCESS_KEY="rustfsadmin"
S3_FORCE_PATH_STYLE="true"

# --- Image classification (optional) ---
# Image classification on upload. off (default) | local | external.
# Off by default: uploads are never classified unless you opt in. "external"
# sends every upload to a third party — see docs/data-processors.md and set
# LEGAL_CLASSIFIER_PROCESSOR below before turning it on.
# Mind the difference between off and broken: leaving this unset (or "off")
# publishes uploads without classifying them, but a value this list does not
# contain — or "external" without both NSFW_API_URL and NSFW_API_KEY — means
# classification was asked for and cannot run, so every upload is held for
# review until it is fixed. Uploading keeps working either way; the startup
# warning names which.
# NSFW_MODE=off
# Score at or above which an image is flagged. Must be > 0 and <= 1 — anything
# else (including 0, which would flag every upload) is ignored and the default
# below applies.
# NSFW_THRESHOLD=0.85
# How long to wait for a verdict before treating it as UNKNOWN (same handling
# as a flagged image). Must be > 0 and <= 60000 — out of range is likewise
# ignored in favour of the default.
# In local mode this bounds the wait, not the work: the model runs on the
# request thread, so a single slow image can overrun it and the verdict simply
# arrives late. It does bound the model *load*, and a request that queued past
# its budget is dropped rather than run.
# NSFW_TIMEOUT_MS=5000
# local mode only — where the ONNX model lives inside the image. The Dockerfile
# fetches and checksums it into this path, so it rarely needs overriding.
# If you do override it, the graph must have image-safety-classifier-xs's head:
# one output named "probabilities" holding three soft-maxed class scores, with
# the explicit-content one at index 1. A model that loads but answers in some
# other shape is refused per image and logged, so uploads are held for review
# rather than published on a score that means something else — but a three-class
# head in a *different order* cannot be detected, and will be believed.
# NSFW_MODEL_PATH=/app/models/nsfw.onnx
# external mode only — makes the service a processor, see docs/data-processors.md
# NSFW_API_URL=
# NSFW_API_KEY=

# --- Accounts / admin ---
# Base URL used to build links in emails.
APP_URL="http://localhost:3000"
# Comma-separated admin allow-list (auto-promoted on register/login).
ADMIN_EMAILS="admin@example.com"
# Set to "false" to disable public self-registration (invites still work).
REGISTRATION_ENABLED="true"

# --- Email (SMTP) ---
# Inside docker-compose the app uses the "mailpit" service by default; these
# host-side values matter only if you run the app outside compose.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Jigsaw <no-reply@jigsaw.local>"

# --- Legal pages (Impressum / privacy policy) ---
# Kept in the environment on purpose, so no operator's personal data ends up in
# git. Nothing here has a default: every value is a statement made to the public,
# and the pages would rather say nothing than assert something false.
#
# NAME, ADDRESS and EMAIL are all three required before the instance is publicly
# reachable. Until they are set, /legal/imprint shows a notice naming the ones
# that are missing, and /legal/privacy says no controller is configured. EMAIL is
# not optional: § 5 DDG asks for a means of fast electronic contact, and it is
# where the privacy policy sends people to exercise their GDPR rights.
#
# ADDRESS holds the lines of a postal address that can receive post, separated by
# "|" — at least two, because a street without a postcode and a locality is not
# an address. Use "|" rather than a "\n" escape: dotenv expands the escape but
# compose does not, so a "\n" works with `npm run dev` and breaks in Docker.
# Example: LEGAL_ADDRESS="Musterweg 1|12345 Musterstadt"
LEGAL_NAME=""
LEGAL_ADDRESS=""
LEGAL_EMAIL=""
# Genuinely optional — the phone line is omitted when empty.
LEGAL_PHONE=""
# Set these when mail, image storage or NSFW classification runs at an external
# provider: the privacy policy then names it as a processor (GDPR Art. 28).
# Leaving LEGAL_MAIL_PROCESSOR or LEGAL_STORAGE_PROCESSOR empty makes the policy
# state that mail / storage is self-hosted, so an external SMTP_HOST or
# S3_ENDPOINT with an empty value here publishes a false statement.
# LEGAL_CLASSIFIER_PROCESSOR has no such "self-hosted" half — NSFW_MODE=off (the
# default) and =local never send the image anywhere, so leaving it empty simply
# omits the paragraph. Set it only alongside NSFW_MODE=external.
# Naming a provider here is the published half; the agreement itself and what
# each service actually receives are covered in docs/data-processors.md.
LEGAL_MAIL_PROCESSOR=""
LEGAL_STORAGE_PROCESSOR=""
LEGAL_CLASSIFIER_PROCESSOR=""
# Where the instance runs, printed as-is ("Deutschland", "the EU"). Left empty,
# the policy says the location is not stated instead of claiming the EU. If you
# host outside the EU or use a non-EU provider above, the policy needs a
# third-country transfer note that this app does not generate — see issue #2.
# One value serves all three languages, so it appears verbatim in the German,
# English and Italian policy; pick a spelling you are happy to show in all three.
LEGAL_HOSTING_REGION=""
# "true" adds the Impressum sentence that the service is private and
# non-commercial with no register entry and no VAT ID. Leave empty if you are a
# business: the sentence would be false and it is not printed by default.
LEGAL_PRIVATE_SERVICE=""
