// Prisma schema for the jigsaw puzzle app.
//
// The datasource provider is switchable between "postgresql" (default) and
// "sqlite" via the DATABASE_PROVIDER env var — the container derives the active
// schema through scripts/prisma.mjs so the same models run on both. Because
// Prisma enums are not supported on SQLite, role/type columns are plain strings
// validated in application code (see lib/roles.ts).

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  // Null while an invited user has not set a password yet.
  passwordHash String?
  // "USER" | "ADMIN" (see lib/roles.ts)
  role         String  @default("USER")
  // Null until the user confirms their email (or an admin creates them verified).
  emailVerified DateTime?
  // Stamped on every password write. Sessions issued before it are rejected in
  // the jwt callback (lib/session-freshness.ts). Null for an account whose
  // password has never changed, which is every row that exists today — so the
  // column arriving logs nobody out.
  passwordChangedAt DateTime?
  // The recipient's own language for transactional mail, independent of the
  // locale of whoever triggers the send — an admin notification and a takedown
  // notice go to someone other than the person making the request. One of
  // `routing.locales` (i18n/routing.ts), validated there rather than in
  // lib/roles.ts: that const union already exists and a second copy would be a
  // second source of truth.
  //
  // Null, deliberately, rather than defaulting to "de": null means nobody has
  // ever established this person's language, which is true of every row
  // predating the column and of every account an admin creates outright.
  // Readers fall back to routing.defaultLocale, so those keep receiving exactly
  // what they do today — but because the state is distinguishable, a first
  // login can fill it in (lib/auth.ts) without ever overwriting a choice
  // somebody actually made. A "de" default would make the two cases identical
  // and the correction impossible.
  locale       String?
  // Terms-of-use acceptance: when, and which version (TERMS_VERSION in lib/legal.ts).
  // Null for accounts that predate the terms, were created by an admin (CLI
  // or direct create), or were invited and not yet activated — see
  // docs/terms-versioning.md.
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt    DateTime @default(now())

  puzzles Puzzle[]
  tokens  VerificationToken[]
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  // "EMAIL_VERIFY" | "INVITE" | "PASSWORD_RESET" (see lib/tokens.ts)
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Hashed with hashReporterIp, exactly as Report.reporterIpHash is, so the
  // reset-request endpoint can rate-limit per IP by counting rows. Null for
  // tokens not created from a request (verification, invites) and for every row
  // that predates the column.
  requesterIpHash String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([requesterIpHash])
}

model BannedEmail {
  id        String   @id @default(cuid())
  // `value` is stored lowercased: the full address for EMAIL, the domain for DOMAIN.
  value     String   @unique
  // "EMAIL" | "DOMAIN"
  type      String
  createdAt DateTime @default(now())
}

model Puzzle {
  id          String   @id @default(cuid())
  title       String
  imageKey    String
  imageWidth  Int
  imageHeight Int
  pieceCount  Int
  cols        Int
  rows        Int
  seed        Int
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  // Image delivery, key claiming and delete cleanup all filter on imageKey.
  // Not unique: an owner may reuse a key across their own puzzles.
  @@index([imageKey])
}

model Report {
  id             String    @id @default(cuid())
  // Deliberately no relation to Puzzle: the report must survive the takedown
  // deleting the puzzle row. Existence is checked at read time in the queue.
  puzzleId       String
  puzzleTitle    String
  // "NSFW" | "ILLEGAL" | "COPYRIGHT" | "OTHER" (see lib/reports.ts)
  category       String
  message        String
  // Both nulled when the report is resolved (anonymization).
  reporterEmail  String?
  reporterIpHash String?
  // "OPEN" | "TAKEDOWN" | "DISMISSED" | "ACCOUNT_DELETED" (see lib/reports.ts).
  // A plain string, so a new value is a code change and needs no migration.
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  // The queue filters on status, rate limiting on reporterIpHash + createdAt,
  // dedup and takedown resolution on puzzleId.
  @@index([status])
  @@index([reporterIpHash])
  @@index([puzzleId])
}

// The classifier's judgement of one stored image, keyed by the object key so
// it survives between the upload request and the puzzle that claims it. Never
// sent to the client: a verdict that travelled through the browser could be
// rewritten by the uploader.
//
// label is a plain string ("CLEAN" | "FLAGGED" | "UNKNOWN", see
// lib/nsfw/verdict.ts) because SQLite has no enums — same as Role and
// Report.status. Rows whose key no puzzle references are swept by
// lib/retention.ts.
model ImageVerdict {
  imageKey  String   @id
  label     String
  score     Float
  model     String
  createdAt DateTime @default(now())

  // The retention sweep selects by age.
  @@index([createdAt])
}
