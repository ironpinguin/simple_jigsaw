// Prisma schema for the jigsaw puzzle app.
//
// PostgreSQL everywhere (dev and prod run via docker-compose). The container
// entrypoint runs `prisma db push` on start to sync this schema; DATABASE_URL
// is provided by compose (service `postgres`).

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  puzzles Puzzle[]
}

model Puzzle {
  id          String   @id @default(cuid())
  title       String
  imageKey    String
  imageWidth  Int
  imageHeight Int
  pieceCount  Int
  cols        Int
  rows        Int
  seed        Int
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}
