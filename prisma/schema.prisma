// Prisma schema for the jigsaw puzzle app.
//
// The datasource provider is switchable between "postgresql" (default) and
// "sqlite" via the DATABASE_PROVIDER env var — the container derives the active
// schema through scripts/prisma.mjs so the same models run on both. Because
// Prisma enums are not supported on SQLite, role/type columns are plain strings
// validated in application code (see lib/roles.ts).

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  // Null while an invited user has not set a password yet.
  passwordHash String?
  // "USER" | "ADMIN" (see lib/roles.ts)
  role         String  @default("USER")
  // Null until the user confirms their email (or an admin creates them verified).
  emailVerified DateTime?
  createdAt    DateTime @default(now())

  puzzles Puzzle[]
  tokens  VerificationToken[]
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  // "EMAIL_VERIFY" | "INVITE"
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BannedEmail {
  id        String   @id @default(cuid())
  // `value` is stored lowercased: the full address for EMAIL, the domain for DOMAIN.
  value     String   @unique
  // "EMAIL" | "DOMAIN"
  type      String
  createdAt DateTime @default(now())
}

model Puzzle {
  id          String   @id @default(cuid())
  title       String
  imageKey    String
  imageWidth  Int
  imageHeight Int
  pieceCount  Int
  cols        Int
  rows        Int
  seed        Int
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}
