// Prisma schema for the jigsaw puzzle app.
//
// PostgreSQL everywhere (dev and prod run via docker-compose). The container
// entrypoint runs `prisma db push` on start to sync this schema; DATABASE_URL
// is provided by compose (service `postgres`).

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  EMAIL_VERIFY
  INVITE
}

enum BanType {
  EMAIL
  DOMAIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  // Null while an invited user has not set a password yet.
  passwordHash String?
  role         Role      @default(USER)
  // Null until the user confirms their email (or an admin creates them verified).
  emailVerified DateTime?
  createdAt    DateTime  @default(now())

  puzzles Puzzle[]
  tokens  VerificationToken[]
}

model VerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BannedEmail {
  // `value` is stored lowercased: the full address for EMAIL, the domain for DOMAIN.
  value     String   @unique
  type      BanType
  createdAt DateTime @default(now())
  id        String   @id @default(cuid())
}

model Puzzle {
  id          String   @id @default(cuid())
  title       String
  imageKey    String
  imageWidth  Int
  imageHeight Int
  pieceCount  Int
  cols        Int
  rows        Int
  seed        Int
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}
