# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# prisma / sqlite (dev)
/prisma/*.db
/prisma/*.db-journal
# derived schema for non-default DATABASE_PROVIDER (see scripts/prisma.mjs)
/prisma/.active.prisma

# generated prisma client (run `prisma generate`)
/lib/generated/

# local uploads (dev filesystem storage)
/storage-data/

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code — personal settings only; .claude/skills/ and settings.json are shared
/.claude/settings.local.json
# scratch worktrees checked out here by agent sessions
/.claude/worktrees/

# CI artifacts
/junit.xml
/gl-sast-report.json
/.npm/

# Kubernetes example — filled-in secrets, never committed
/deploy/kubernetes/secret.yaml

# ignore local docker compose to overwrite e.g. port conflicts
docker-compose.local.yml

# The ONNX classifier model (13 MB). The Dockerfile fetches and checksums it
# into the production image; a host copy is only for trying NSFW_MODE=local in
# the dev stack, where the bind mount shadows the image's /app/models.
/models/
